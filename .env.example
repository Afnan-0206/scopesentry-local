# ScopeSentry Local Configuration

# Server Port (default 3001)
PORT=3001

# Host to bind (default 127.0.0.1 for strict loopback privacy)
HOST=127.0.0.1

# Frontend Origin for CORS (default http://localhost:5173 or http://127.0.0.1:5173)
FRONTEND_ORIGIN=http://localhost:5173

# Ollama Base URL (default local loopback)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama Default Model (e.g. qwen2.5:7b or qwen2.5:0.5b)
OLLAMA_MODEL=qwen2.5:7b

# Ollama Request Timeout in milliseconds (default 120000 = 2 minutes)
OLLAMA_TIMEOUT_MS=120000

# Text limits
MAX_AGREEMENT_CHARS=20000
MAX_REQUEST_CHARS=10000
